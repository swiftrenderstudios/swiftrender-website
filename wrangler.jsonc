{
  // Must match the Worker name in the Cloudflare dashboard exactly.
  "name": "swiftrender-website",

  // The Worker that handles /api/brief (see worker/index.js).
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    // Output of `npm run build` (Vite).
    "directory": "./dist",
    // Lets the Worker hand non-API requests to the static site.
    "binding": "ASSETS",
    // React Router: unknown paths (e.g. /contact) serve index.html.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; pages/images/video stay free static requests.
    "run_worker_first": ["/api/*"]
  },

  // Lets /api/brief report which deployed version is live.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "observability": {
    "enabled": true
  }
}
